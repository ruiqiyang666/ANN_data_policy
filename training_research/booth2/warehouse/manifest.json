 "table_notes": {
  "electrode_cycle": "电极安装周期（v2，11/17 纠正后）。eol_endpoint = 最终连续失败序列第一件开始加工 T；source_* 为 v1 口径。",
  "electrode_cycle_v1_legacy": "v1（11/16）周期表原样保留：eol_endpoint = 第二件失败产品结束；划分为 v1 划分。仅供追溯。",
  "target_event": "连续失败事件（v2）：time = 第一件失败产品开始加工；is_eol=1 为电极末期事件。",
  "product_failure_event_v1": "v1 逐产品事件（first_* / adjacent_two_*）：time = 该产品结束（标签可得）时刻。",
  "product": "全量产品（13,181）。split = v2 划分，source_split = v1 划分；其余列与 training_data/products.csv 相同。",
  "maintenance_event": "换枪登记 / 现场确认记录；action_time_lower/upper 是候选范围，不是精确拆装秒。",
  "label_sample": "353 件关注产品（审阅子集，不能单独用于训练）。",
  "split_summary": "v2 划分汇总。",
  "split_summary_v1_legacy": "v1 划分汇总。",
  "anchor": "v2 加工原点（10 s，开工确认 ≥3 s）：9 个传感器当秒读数 + 过去 60 s 电压均值/标准差。product_id 为本库派生。",
  "target": "v2 监督目标：y=1 当 lo < remaining_seconds ≤ hi；观测范围不足以判定时为 NULL（不能当 0）。",
  "anchor_feature_28": "v1 原点特征（28 路当秒值 + 60 s 均值 + 电压 60 s 标准差）。in_v2=0 的原点在产品开始后 <3 s，被 v2 剔除。",
  "target_v1_legacy": "v1 目标原样保留。rul_strict_seconds 以 v1 终点（第二件失败结束）计，比 v2 remaining_seconds 多 153–157 s；L012 在 v1 为空。",
  "model_registry": "模型登记。阈值 1.000001 是“不报警”哨兵（验证误报预算内无可用阈值），alarm_enabled=0。",
  "prediction": "追加式预测台账；当前内容为 v2 冻结台账（12 个候选 × 81,235 原点）的评分。",
  "alarm": "v2 冻结评估发出的报警（gru_16 与 hgb_depth2）；score 是未校准评分，不是概率。",
  "event_result": "v2 冻结评估的逐事件结果（12 候选 × 10 个 EOL 事件）。"
 },
